diff --git a/Memtly.Core/Memtly.Core/src/modules/utilities/heic.mjs b/Memtly.Core/Memtly.Core/src/modules/utilities/heic.mjs
new file mode 100644
index 0000000..24e5fca
--- /dev/null
+++ b/Memtly.Core/Memtly.Core/src/modules/utilities/heic.mjs
@@ -0,0 +1,116 @@
+const HEVC_BRANDS = new Set(['heic', 'heix', 'hevc', 'hevx']);
+const DEFAULT_SCAN_BYTES = 64 * 1024;
+
+function readUint64(view, offset) {
+    const high = view.getUint32(offset);
+    const low = view.getUint32(offset + 4);
+    const value = (high * 0x100000000) + low;
+    return Number.isSafeInteger(value) ? value : null;
+}
+
+function readBrand(view, offset) {
+    return String.fromCharCode(
+        view.getUint8(offset),
+        view.getUint8(offset + 1),
+        view.getUint8(offset + 2),
+        view.getUint8(offset + 3)
+    );
+}
+
+export function hasHevcHeifBrand(buffer) {
+    const view = buffer instanceof DataView ? buffer : new DataView(buffer);
+    let offset = 0;
+
+    while (offset + 8 <= view.byteLength) {
+        let size = view.getUint32(offset);
+        const type = readBrand(view, offset + 4);
+        let headerSize = 8;
+
+        if (size === 1) {
+            if (offset + 16 > view.byteLength) return false;
+            size = readUint64(view, offset + 8);
+            headerSize = 16;
+        } else if (size === 0) {
+            size = view.byteLength - offset;
+        }
+
+        if (size === null || size < headerSize || offset + size > view.byteLength) return false;
+
+        if (type === 'ftyp') {
+            if (size < headerSize + 8) return false;
+            const majorBrand = readBrand(view, offset + headerSize);
+            if (HEVC_BRANDS.has(majorBrand)) return true;
+
+            for (let brandOffset = offset + headerSize + 8; brandOffset + 4 <= offset + size; brandOffset += 4) {
+                if (HEVC_BRANDS.has(readBrand(view, brandOffset))) return true;
+            }
+            return false;
+        }
+
+        offset += size;
+    }
+
+    return false;
+}
+
+export async function isHeicFile(file, maxScanBytes = DEFAULT_SCAN_BYTES) {
+    if (!file || typeof file.slice !== 'function') return false;
+    const scanLength = Math.min(file.size, maxScanBytes);
+    if (scanLength < 16) return false;
+    return hasHevcHeifBrand(await file.slice(0, scanLength).arrayBuffer());
+}
+
+function jpegName(name) {
+    return /\.(heic|heif)$/i.test(name) ? name.replace(/\.(heic|heif)$/i, '.jpg') : `${name}.jpg`;
+}
+
+function withTimeout(promise, timeoutMs) {
+    let timer;
+    return Promise.race([
+        promise,
+        new Promise((_, reject) => {
+            timer = setTimeout(() => reject(new Error('HEIC conversion timed out')), timeoutMs);
+        })
+    ]).finally(() => clearTimeout(timer));
+}
+
+async function assertJpeg(blob) {
+    const magic = new Uint8Array(await blob.slice(0, 3).arrayBuffer());
+    if (magic.length !== 3 || magic[0] !== 0xff || magic[1] !== 0xd8 || magic[2] !== 0xff) {
+        throw new Error('HEIC conversion did not produce a JPEG');
+    }
+}
+
+async function assertPixelLimit(blob, maxPixels) {
+    if (!maxPixels || typeof createImageBitmap !== 'function') return;
+    const bitmap = await createImageBitmap(blob);
+    try {
+        if ((bitmap.width * bitmap.height) > maxPixels) {
+            throw new Error('Converted image exceeds the pixel limit');
+        }
+    } finally {
+        bitmap.close();
+    }
+}
+
+export async function convertHeicToJpeg(file, options = {}) {
+    const maxInputBytes = options.maxInputBytes ?? (25 * 1024 * 1024);
+    const maxPixels = options.maxPixels ?? 40_000_000;
+    const timeoutMs = options.timeoutMs ?? 45_000;
+    const quality = options.quality ?? 0.92;
+
+    if (file.size > maxInputBytes) throw new Error('HEIC file exceeds the conversion size limit');
+    if (!(await isHeicFile(file))) return file;
+
+    const { default: heic2any } = await import('heic2any');
+    let converted = await withTimeout(heic2any({ blob: file, toType: 'image/jpeg', quality }), timeoutMs);
+    if (Array.isArray(converted)) converted = converted[0];
+    if (!(converted instanceof Blob)) throw new Error('HEIC conversion produced no image');
+    await assertJpeg(converted);
+    await assertPixelLimit(converted, maxPixels);
+
+    return new File([converted], jpegName(file.name), {
+        type: 'image/jpeg',
+        lastModified: file.lastModified
+    });
+}
diff --git a/Memtly.Core/tests/heic-classifier.test.mjs b/Memtly.Core/tests/heic-classifier.test.mjs
new file mode 100644
index 0000000..3257592
--- /dev/null
+++ b/Memtly.Core/tests/heic-classifier.test.mjs
@@ -0,0 +1,68 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { hasHevcHeifBrand, isHeicFile } from '../Memtly.Core/src/modules/utilities/heic.mjs';
+
+function box(type, payload = []) {
+    const bytes = new Uint8Array(8 + payload.length);
+    const view = new DataView(bytes.buffer);
+    view.setUint32(0, bytes.length);
+    for (let index = 0; index < 4; index++) bytes[4 + index] = type.charCodeAt(index);
+    bytes.set(payload, 8);
+    return bytes;
+}
+
+function ftyp(major, compatible = []) {
+    const payload = new Uint8Array(8 + (compatible.length * 4));
+    for (let index = 0; index < 4; index++) payload[index] = major.charCodeAt(index);
+    compatible.forEach((brand, brandIndex) => {
+        for (let index = 0; index < 4; index++) payload[8 + (brandIndex * 4) + index] = brand.charCodeAt(index);
+    });
+    return box('ftyp', payload);
+}
+
+function combine(...parts) {
+    const total = parts.reduce((size, part) => size + part.length, 0);
+    const bytes = new Uint8Array(total);
+    let offset = 0;
+    for (const part of parts) {
+        bytes.set(part, offset);
+        offset += part.length;
+    }
+    return bytes;
+}
+
+test('accepts HEVC HEIF major brands', () => {
+    for (const brand of ['heic', 'heix', 'hevc', 'hevx']) {
+        assert.equal(hasHevcHeifBrand(ftyp(brand).buffer), true, brand);
+    }
+});
+
+test('accepts generic mif1/mif3 only with a compatible HEVC brand', () => {
+    assert.equal(hasHevcHeifBrand(ftyp('mif1', ['heic']).buffer), true);
+    assert.equal(hasHevcHeifBrand(ftyp('mif3', ['heic']).buffer), true);
+    assert.equal(hasHevcHeifBrand(ftyp('mif1').buffer), false);
+    assert.equal(hasHevcHeifBrand(ftyp('mif3').buffer), false);
+});
+
+test('rejects AVIF and malformed boxes', () => {
+    assert.equal(hasHevcHeifBrand(ftyp('avif', ['mif1']).buffer), false);
+    assert.equal(hasHevcHeifBrand(new Uint8Array([0, 0, 0, 99, 102, 116, 121, 112]).buffer), false);
+    assert.equal(hasHevcHeifBrand(new Uint8Array(15).buffer), false);
+});
+
+test('finds ftyp after a bounded leading box', () => {
+    assert.equal(hasHevcHeifBrand(combine(box('free', [1, 2, 3, 4]), ftyp('heic')).buffer), true);
+});
+
+test('uses content rather than extension or MIME', async () => {
+    const fake = new File([new Uint8Array([0xff, 0xd8, 0xff, 0xd9])], 'renamed.heic', { type: 'image/heic' });
+    const emptyMime = new File([ftyp('mif3', ['heic'])], 'camera.bin', { type: '' });
+    assert.equal(await isHeicFile(fake), false);
+    assert.equal(await isHeicFile(emptyMime), true);
+});
+
+test('does not read beyond the classifier scan bound', async () => {
+    const prefix = new Uint8Array(64);
+    const file = new File([prefix, ftyp('heic')], 'late.heic', { type: 'image/heic' });
+    assert.equal(await isHeicFile(file, 64), false);
+});
